# Copy to .env.local and fill in. Never commit real values.
#
# Chain data (chain IDs, RPC URLs, explorer URLs, USDT) comes from @uzolabs/sdk.
# Do not add it here.
#
# The deployer key is never stored in an env file. Use a Foundry keystore
# (cast wallet import) on the deployer's machine.

# WalletConnect project ID used by the wallet connection modal (public, but kept out of the repo)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
